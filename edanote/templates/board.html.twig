<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ app.name }}</title>
  <link rel="stylesheet" href="./assets/app.css">
</head>
<body>
<header class="site-header">
  <a class="brand" href="./">{{ app.name }}</a>
  <p>{{ app.description }}</p>
</header>
<main>
  <section class="composer card" aria-labelledby="new-thread">
    <h1 id="new-thread">新しい絵を投稿</h1>
    {% for error in errors %}<p class="error">{{ error }}</p>{% endfor %}
    <form method="post" enctype="multipart/form-data">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="form-row">
        <label>名前 <input name="name" maxlength="50" value="{{ old.name|default('') }}"></label>
        <label>題名 <input name="subject" maxlength="100" value="{{ old.subject|default('') }}"></label>
      </div>
      <label>絵 <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp"></label>
      <label>本文 <textarea name="comment" maxlength="4000" required>{{ old.comment|default('') }}</textarea></label>
      <button type="submit">投稿する</button>
    </form>
  </section>

  {% for thread in threads %}
    <article class="thread card" id="post-{{ thread.id }}">
      {% include 'post.html.twig' with {post: thread} only %}
      {% if thread.replies %}
        <div class="replies">
          {% for reply in thread.replies %}
            <article id="post-{{ reply.id }}">{% include 'post.html.twig' with {post: reply} only %}</article>
          {% endfor %}
        </div>
      {% endif %}
      <details>
        <summary>返信する</summary>
        <form method="post" enctype="multipart/form-data" class="reply-form">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="parent_id" value="{{ thread.id }}">
          <label>名前 <input name="name" maxlength="50"></label>
          <label>絵 <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp"></label>
          <label>本文 <textarea name="comment" maxlength="4000" required></textarea></label>
          <button type="submit">返信する</button>
        </form>
      </details>
    </article>
  {% else %}
    <p class="empty">まだ投稿はありません。最初の一枚をどうぞ。</p>
  {% endfor %}

  {% if pages > 1 %}
    <nav class="pagination" aria-label="ページ">
      {% for number in 1..pages %}
        <a href="?page={{ number }}" {% if number == page %}aria-current="page"{% endif %}>{{ number }}</a>
      {% endfor %}
    </nav>
  {% endif %}
</main>
</body>
</html>
